# Copy to .env and fill in. .env is gitignored — never commit real keys.

# Yellowstone-compatible gRPC endpoint(s). Helius LaserStream regions:
#   ewr, pitt, slc, lax, lon, ams, fra, tyo, sgp  (pick the one closest to your server)
# Add a second provider comma-separated for redundancy.
GRPC_ENDPOINTS=https://laserstream-mainnet-ewr.helius-rpc.com
# x-token per endpoint (for Helius this is your API key)
GRPC_X_TOKENS=your-helius-api-key

# JSON-RPC (state snapshot + account refresh after dead slots)
RPC_URL=https://mainnet.helius-rpc.com/?api-key=your-helius-api-key

DATABASE_URL=postgres://dlmm:dlmm@localhost:5432/dlmm

# Optional tuning (defaults shown)
# COMMITMENT=confirmed            # processed | confirmed | finalized
# INDEX_FAILED_TXS=false
# FLUSH_INTERVAL_MS=100
# SLOT_META_TIMEOUT_MS=3000
# STREAM_IDLE_TIMEOUT_SECS=30
# RESUME_REWIND_SLOTS=64
# HTTP_ADDR=0.0.0.0:9100
# MAX_READY_LAG_SLOTS=150
# LOG_JSON=false
# RUST_LOG=info
